# Get a free key at https://console.groq.com/keys — no card required.
GROQ_API_KEY=your_groq_api_key_here
PORT=3000

# Optional: text model for normal messages. Defaults to openai/gpt-oss-120b.
# See https://console.groq.com/docs/models for the full list.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: vision model used automatically when a message includes an
# image. Defaults to qwen/qwen3.6-27b. See https://console.groq.com/docs/vision
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Required for real deployments: comma-separated list of origins allowed to
# call the API, e.g. https://yourname.github.io — leave unset only for local
# testing. Left empty, ANY website can call your API and spend your Groq quota.
ALLOWED_ORIGINS=

# Optional: per-IP rate limits protecting your Groq quota from abuse.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=200
